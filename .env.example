NEXT_PUBLIC_SANITY_PROJECT_ID=vmnu14pm
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SITE_URL=https://pcg-bay.vercel.app

# Contact form (Resend) — https://resend.com
# RESEND_API_KEY is required to send.
# Recipients are normally managed in the CMS (Contact Page → Contact Form Recipients).
# CONTACT_TO_EMAIL is only used as a fallback when no CMS recipients are set.
# CONTACT_FROM_EMAIL must use a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=PCG Website <onboarding@resend.dev>

# Newsletter (Campaign Monitor) — https://www.campaignmonitor.com
# API key: Account Settings → API keys
# List ID: Lists & Subscribers → [your list] → Settings (or change name / change type screen)
CAMPAIGN_MONITOR_API_KEY=
CAMPAIGN_MONITOR_LIST_ID=
